#include <stdio.h>
int main() {
int n, x;
scanf("%d", &n);
int a[n];
for (int i = 0; i < n; i++) {
scanf("%d", &a[i]);
}
scanf("%d", &x);
int low = 0, high = n - 1;
int floor = -1;
while (low <= high) {
int mid = low + (high - low) / 2;
if (a[mid] <= x) {
floor = a[mid];
low = mid + 1;
} else {
high = mid - 1;
}
}
printf("%d", floor);
return 0;
}
