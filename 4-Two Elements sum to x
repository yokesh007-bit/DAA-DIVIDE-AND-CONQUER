#include <stdio.h>
int findPair(int arr[], int low, int high, int x) {
if (low >= high)
return 0;
int sum = arr[low] + arr[high];
if (sum == x) {
printf("%d\n%d", arr[low], arr[high]);
return 1;
}
if (sum < x)
return findPair(arr, low + 1, high, x);
return findPair(arr, low, high - 1, x);
}
int main() {
int n, x;
scanf("%d", &n);
int arr[n];
for (int i = 0; i < n; i++)
scanf("%d", &arr[i]);
scanf("%d", &x);
if (!findPair(arr, 0, n - 1, x))
printf("No");
return 0;
}
