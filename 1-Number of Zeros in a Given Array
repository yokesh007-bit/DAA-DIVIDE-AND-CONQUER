#include <stdio.h>
int findFirstZero(int arr[], int low, int high)
{
if (low > high)
return -1;
int mid = (low + high) / 2;
if (arr[mid] == 0)
{
if (mid == 0 || arr[mid - 1] == 1)
return mid;
return findFirstZero(arr, low, mid - 1);
}
else
{
return findFirstZero(arr, mid + 1, high);
}
}
int main()
{
int n;
scanf("%d", &n);
int arr[n];
for (int i = 0; i < n; i++)
{
scanf("%d", &arr[i]);
}
int index = findFirstZero(arr, 0, n - 1);
if (index == -1)
printf("0");
else
printf("%d", n - index);
return 0;}
